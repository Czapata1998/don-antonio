# ─────────────────────────────────────────────────────────────
# Base de datos (SQLite local) — necesaria para reservas y panel.
# ─────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ─────────────────────────────────────────────────────────────
# Panel de administración (/admin) — un solo barbero.
# ADMIN_PASSWORD: la clave con la que entra Sergio.
# ADMIN_SESSION_SECRET: cadena larga y aleatoria para firmar la cookie.
# ─────────────────────────────────────────────────────────────
ADMIN_PASSWORD="cambia-esta-clave"
ADMIN_SESSION_SECRET="una-cadena-larga-y-aleatoria-de-al-menos-32-caracteres"

# ─────────────────────────────────────────────────────────────
# Envío de correos por Gmail (Nodemailer)
# Copia este archivo a ".env.local" y rellena los valores.
# ─────────────────────────────────────────────────────────────

# Cuenta Gmail que ENVÍA los correos (el "from").
GMAIL_USER="tucuenta@gmail.com"

# Contraseña de aplicación de 16 caracteres (NO tu contraseña normal).
# Requiere verificación en 2 pasos activada. Genérala en:
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"

# Correo de Sergio (el barbero) que RECIBE el aviso de cada reserva.
# Si lo dejas vacío, el aviso llega a GMAIL_USER.
BARBER_EMAIL="sergio@ejemplo.com"

# ─────────────────────────────────────────────────────────────
# Aviso GRATIS por Telegram (recomendado) — push a tu celular.
# 1) En Telegram escribe a @BotFather → /newbot → copia el TOKEN.
# 2) Escríbele algo a tu bot nuevo.
# 3) Abre https://api.telegram.org/bot<TOKEN>/getUpdates y copia
#    el "chat":{"id":...} → ese es TELEGRAM_CHAT_ID.
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
TELEGRAM_CHAT_ID="123456789"

# ─────────────────────────────────────────────────────────────
# SMS al barbero (Twilio, DE PAGO) — el "mensaje de texto" a tu número.
# Crea cuenta en https://www.twilio.com/ y toma estos datos del panel.
# En cuenta de prueba (trial) SOLO puedes enviar a números verificados.
# ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="tu_auth_token"
# Número Twilio emisor (formato E.164), ej: +18325551234
TWILIO_FROM="+1XXXXXXXXXX"
# TU número donde quieres recibir el SMS (formato E.164), ej: +573001234567
BARBER_PHONE="+57XXXXXXXXXX"
