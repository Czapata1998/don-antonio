# ─────────────────────────────────────────────────────────────
# Variables de entorno para producción (Dokploy → Environment).
# Copia estos valores en el panel de Dokploy de tu aplicación.
# ─────────────────────────────────────────────────────────────

# Base de datos SQLite dentro del volumen persistente (NO cambiar la ruta).
DATABASE_URL="file:/app/data/dev.db"

# ── Panel de administración ──────────────────────────────────
# Contraseña del barbero para entrar a /admin (¡cámbiala!).
ADMIN_PASSWORD="pon-una-clave-fuerte"
# Secreto para firmar la cookie de sesión (cadena larga y aleatoria).
ADMIN_SESSION_SECRET="genera-32+caracteres-aleatorios-aqui"

# ── Correos de confirmación (Gmail + App Password) ───────────
# Sin estos, la reserva funciona igual pero NO envía correos (modo simulado).
GMAIL_USER="tucuenta@gmail.com"
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"
BARBER_EMAIL="sergio@ejemplo.com"

# ── Aviso al barbero por Telegram (opcional, gratis) ─────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ── SMS por Twilio (opcional, de pago) ───────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
BARBER_PHONE=""
